{
  "name": "lambdas",
  "version": "1.0.0",
  "private": true,
  "main": "dist/producer.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/producer.ts --bundle --platform=node --target=node20 --outfile=producer-bundle.js && esbuild src/worker.ts --bundle --platform=node --target=node20 --outfile=worker-bundle.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.645.0",
    "@aws-sdk/client-sqs": "^3.645.0",
    "@aws-sdk/lib-dynamodb": "^3.645.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4"
  }
}
